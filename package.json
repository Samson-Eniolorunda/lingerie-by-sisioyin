{
  "name": "lingerie-by-sisioyin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:forbidden && npm test",
    "test:sql": "bash tests/sql/run.sh",
    "stack:up": "bash tests/support/local-stack/up.sh",
    "stack:down": "bash tests/support/local-stack/down.sh",
    "test:contract": "bash tests/contract/run.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
